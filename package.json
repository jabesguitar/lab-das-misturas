{
  "name": "lab-das-misturas",
  "version": "1.0.0",
  "description": "Jogo educativo de Ciências - 6º ano",
  "author": "Lab das Misturas",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/cli": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.labmisturas.app",
    "productName": "Lab das Misturas",
    "files": ["main.js", "www/**/*"],
    "win": { "target": ["nsis", "portable"] },
    "nsis": { "oneClick": true }
  }
}
